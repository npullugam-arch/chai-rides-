---
import RecordCards from './AdminRecordCards.astro';
const { settings, links, policies } = Astro.props;
---
<div class="cms-heading"><span class="eyebrow">Public website</span><h1>Footer management</h1></div>
{settings.map((s:any)=><section class="cms-panel"><h2>Footer contact and brand</h2><form class="ajax-form cms-form grid" data-resource="settings" data-id={s.id}><label>Business phone<input name="phone" value={s.phone||'+91 6302567570'} required /></label><label>WhatsApp number<input name="whatsapp_number" value={s.whatsapp_number||s.phone||'+91 6302567570'} required /></label><label>Instagram URL<input name="instagram_url" type="url" value={s.instagram_url||''} /></label><label>Email<input name="footer_email" type="email" value={s.footer_email||''} /></label><label>Location<input name="footer_location" value={s.footer_location||s.location||''} /></label><label>Business hours<input name="business_hours" value={s.business_hours||''} /></label><label class="wide">Footer introduction<textarea name="footer_intro">{s.footer_intro||''}</textarea></label><label class="wide">Footer logo URL<input name="footer_logo_url" type="url" value={s.footer_logo_url||''} /></label><button class="cms-btn">Save footer settings</button></form></section>)}
<section class="cms-panel"><h2>Quick links and social links</h2><form class="ajax-form cms-form grid" data-resource="footer_links"><label>Label<input name="label" required /></label><label>URL<input name="href" required /></label><label>Group<select name="link_group"><option value="quick">Quick link</option><option value="social">Social link</option></select></label><label>Sort order<input name="sort_order" type="number" value="0" /></label><label><input name="is_published" type="checkbox" checked /> Published</label><button class="cms-btn">Add link</button></form></section>
<RecordCards records={links} resource="footer_links" fields={['label','href','link_group','sort_order','is_published']} />
<section class="cms-panel"><h2>Legal policies</h2><form class="ajax-form cms-form grid" data-resource="legal_policies"><label>Slug<input name="slug" required pattern="[a-z0-9-]+" /></label><label>Title<input name="title" required /></label><label class="wide">Content<textarea name="content" required></textarea></label><label>Sort order<input name="sort_order" type="number" value="0" /></label><label><input name="is_published" type="checkbox" checked /> Published</label><button class="cms-btn">Add policy</button></form></section>
<RecordCards records={policies} resource="legal_policies" fields={['slug','title','content','sort_order','is_published']} />
