---
import Logo from './Logo.astro';
import { THEMES, type ThemeKey } from '../data/themes';

interface Props { name: string; themeKey: ThemeKey; showSwitcher: boolean; showHomeBack?: boolean; links?: { href: string; label: string }[] }
const { name, themeKey, showSwitcher, showHomeBack = false, links = [{ href: '/#beans', label: 'Beans' }, { href: '/#menu', label: 'Menu' }, { href: '/#visit', label: 'Visit' }] } = Astro.props;
const themes = Object.entries(THEMES) as [ThemeKey, (typeof THEMES)[ThemeKey]][];
const franchiseLink = links.find((link) => link.href === '/franchise');
---
<header class="head">
  <div class="wrap head-in">
    {showHomeBack && <a class="home-back" href="/" aria-label="Back to home"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 3.5 6 8l4.5 4.5M6.5 8h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg><span>Home</span></a>}
    <a class="logo" href="/" aria-label={`${name}, home`}>
      <Logo />
      <span class="logo-text">{name}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a class={l.href === '/franchise' ? 'franchise-nav' : undefined} href={l.href}>{l.label}{l.href === '/franchise' && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8h7M8 5l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>}</a>)}
    </nav>
    {franchiseLink && <a class="mobile-franchise" href="/franchise">Franchise<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8h7M8 5l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>}
    {showSwitcher && (
      <div class="theme-picker" data-theme-picker>
        <span class="theme-name" id="themeName" aria-live="polite">{THEMES[themeKey].label}</span>
        <button class="theme-trigger" id="themeTrigger" type="button" aria-label="Choose colour theme" aria-expanded="false" aria-controls="swatches">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="2.2" /><circle cx="16" cy="8" r="2.2" /><circle cx="8" cy="16" r="2.2" /><circle cx="16" cy="16" r="2.2" /></svg>
        </button>
        <fieldset class="swatches" id="swatches">
          <legend class="sr-only">Colour theme</legend>
          {themes.map(([k, t]) => (
            <label class="sw" title={t.label}>
              <input type="radio" name="theme" value={k} checked={k === themeKey} data-label={t.label} />
              <span style={`--a:${t.c.paper};--b:${t.d3.cup}`} aria-hidden="true"></span>
              <span class="sr-only">{t.label}</span>
            </label>
          ))}
        </fieldset>
      </div>
    )}
  </div>
</header>
