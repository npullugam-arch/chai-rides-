---
interface Props { records:any[]; resource:string; fields:string[]; searchable?:boolean }
const {records,resource,fields,searchable=false}=Astro.props;
const isLong=(f:string)=>f.includes('description')||f.includes('message')||f.includes('notes')||f==='answer'||f==='terms'||f==='address';
---
<div class="record-grid">{records.map(r=><article class="cms-panel" data-search={searchable?fields.map(f=>String(r[f]||'')).join(' ').toLowerCase():undefined} data-status={r.status}><form class="ajax-form cms-form" data-resource={resource} data-id={r.id}>{fields.map(f=>typeof r[f]==='boolean'?<label><input type="checkbox" name={f} checked={r[f]}/>{f.replaceAll('_',' ')}</label>:isLong(f)?<label>{f.replaceAll('_',' ')}<textarea name={f}>{r[f]??''}</textarea></label>:f==='status'?<label>Status<select name="status">{['new','contacted','in_progress','converted','closed','planned','active','inactive'].map(s=><option value={s} selected={r[f]===s}>{s}</option>)}</select></label>:<label>{f.replaceAll('_',' ')}<input name={f} value={r[f]??''} type={f.includes('amount')||f.includes('price')||f==='quantity'||f==='sort_order'?'number':'text'} step="0.01"/></label>)}<button class="cms-btn">Save changes</button><button class="delete-btn" type="button" data-resource={resource} data-id={r.id}>Delete</button></form></article>)}</div>
<style>.record-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:1rem}.cms-panel{background:white;border:1px solid #d9ddd7;border-radius:14px;padding:1.25rem}.cms-form{display:grid;gap:.8rem}.cms-form label{display:grid;gap:.3rem;text-transform:capitalize;font-weight:650}.cms-form input,.cms-form textarea,.cms-form select{padding:.7rem;border:1px solid #bfc7bf;border-radius:7px;font:inherit;background:white;color:#173126}.cms-form textarea{min-height:85px}.cms-btn{background:#e76f2e;color:white;border:0;border-radius:9px;padding:.75rem 1rem;font-weight:750;cursor:pointer}.delete-btn{background:transparent;border:1px solid #b33;color:#b33;border-radius:7px;padding:.6rem;cursor:pointer}</style>
