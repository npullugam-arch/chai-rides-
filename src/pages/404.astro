---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadSite } from '../lib/content';
import { loadFooterContent } from '../lib/supabase';

const [site, footer] = await Promise.all([loadSite(), loadFooterContent()]);
const { settings: s } = site;
---

<Base site={site} title={`Page not found · ${s.name}`} noindex>
  <Header name={s.name} themeKey={site.themeKey} showSwitcher={false} />
  <main id="main" class="wrap notfound">
    <span class="eyebrow">404</span>
    <h1>Spilled it.</h1>
    <p class="lede" style="margin-inline:auto">That page doesn't exist, or it moved. The chai is still brewing, though.</p>
    <a class="btn" href="/">Back to the homepage</a>
  </main>
  <Footer footer={footer} />
</Base>
