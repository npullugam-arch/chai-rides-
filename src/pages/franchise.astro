---
import SimpleBase from '../layouts/SimpleBase.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import FranchiseIcon from '../components/FranchiseIcon.astro'; import FranchiseLocations from '../components/FranchiseLocations.astro'; import { loadFooterContent, loadFranchiseContent, publicSupabaseConfigured } from '../lib/supabase';
let content:any=null,loadError='';try{content=await loadFranchiseContent()}catch(e){loadError=e instanceof Error?e.message:'Unable to load franchise information.'}
const footer=await loadFooterContent();
const settings=content?.settings,packages=(content?.packages||[]).slice(0,2),benefits=content?.benefits||[],faqs=content?.faqs||[],locations=content?.locations||[];
const classic=packages.find((p:any)=>p.slug==='classic-franchise')||packages[0],standard=packages.find((p:any)=>p.slug==='standard-franchise')||packages[1];
const phone=settings?.phone||'+91 6302567570',digits=phone.replace(/\D/g,'');const defaultMessage=settings?.whatsapp_message||'Hello Chai Rides Team, I am interested in starting a Chai Rides franchise. Could you please provide more information about the Classic and Standard franchise packages, investment requirements, included equipment, and application process? I look forward to hearing from you. Thank you.';
const money=(n:number)=>new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n);
const item=(p:any,name:string)=>(p?.franchise_package_items||[]).find((i:any)=>i.name.toLowerCase().includes(name.toLowerCase()));
const groupName=(i:any)=>/led tv|induction/i.test(i.name)?'Additional Equipment':/branding|board|frame/i.test(i.category)?'Branding Equipment':/kitchen/i.test(i.category)?'Kitchen Equipment':/furniture|woodwork/i.test(i.category)?'Furniture and Woodwork':/raw/i.test(i.category)?'Raw Materials':'Additional Equipment';
const groups=(p:any)=>['Branding Equipment','Kitchen Equipment','Furniture and Woodwork','Raw Materials','Additional Equipment'].map(name=>({name,items:(p?.franchise_package_items||[]).filter((i:any)=>groupName(i)===name).sort((a:any,b:any)=>a.sort_order-b.sort_order)})).filter(g=>g.items.length);
const iconType=(name:string)=>name.startsWith('Branding')?'branding':name.startsWith('Kitchen')?'kitchen':name.startsWith('Furniture')?'furniture':name.startsWith('Raw')?'raw':'additional';
const spec=(i:any)=>i.dimensions||'Not applicable'; const qty=(i:any)=>i.quantity!=null?`${i.quantity} ${i.unit||'unit'}`:'Not specified';
const included=(p:any,name:string)=>Boolean(item(p,name));
const highlights=(p:any)=>benefits.filter((b:any)=>b.package_id===p?.id&&['general','training','marketing'].includes(b.benefit_type)).slice(0,5);
---
<SimpleBase title="Chai Rides Franchise · Ride to Sip" description="Explore Classic and Standard Chai Rides franchise packages in Siddipet, Telangana.">
<Header name="CHAI RIDES" themeKey="espresso" showSwitcher={false} showHomeBack={true} links={[{href:'/#menu',label:'Menu'},{href:'#packages',label:'Packages'},{href:'#apply',label:'Apply'}]} />
<main id="main" class="franchise-page">
  <section class="fr-hero">
    <div class="hero-orb orb-one"></div><div class="hero-orb orb-two"></div>
    <div class="wrap hero-layout">
      <div class="hero-copy reveal"><div class="brand-lockup"><img src="/chai-rides-logo.png" alt="Chai Rides" /><div><span>Siddipet · Telangana · India</span><strong>{settings?.tagline||'Ride to Sip'}</strong></div></div><h1>{settings?.hero_heading||'Build your next chapter with Chai Rides.'}</h1><p>{settings?.hero_text||'A premium Indian chai franchise with a focused format, practical support and two clear investment paths.'}</p><div class="hero-actions"><a class="button button-primary" href="#packages">Explore Franchise Packages</a><a class="button button-ghost" href={`https://wa.me/${digits}?text=${encodeURIComponent(defaultMessage)}`} target="_blank" rel="noopener">Enquire on WhatsApp</a></div><div class="hero-proof"><span><strong>2</strong> clear packages</span><span><strong>3 days</strong> training</span><span><strong>0</strong> royalty listed</span></div></div>
      <div class="chai-scene brand-scene reveal"><span class="brand-halo" aria-hidden="true"></span><img class="hero-brand-gif" src="/chai-rides-logo.png" alt="Chai Rides — Ride to Sip" /><div class="scene-note"><span>Franchise from</span><strong>{classic&&money(classic.investment_amount)}</strong></div></div>
    </div>
  </section>

  {!publicSupabaseConfigured&&<section class="wrap notice"><strong>Supabase setup required</strong><p>Package content will appear after the database is configured.</p></section>}{loadError&&<section class="wrap notice error"><strong>Unable to load franchise information</strong><p>{loadError}</p></section>}

  {content&&<>
    <section class="wrap intro-section reveal"><div class="intro-title"><span class="kicker">A modern chai business</span><h2>A familiar ritual, shaped into a focused franchise.</h2></div><div class="intro-story"><p>{settings?.about_content||'Chai Rides brings a recognisable tea-and-snacks format together with practical training, operational guidance and marketing support.'}</p><strong>Rooted in Siddipet. Ready for the next chai destination.</strong><span class="intro-steam" aria-hidden="true">♨</span></div></section>

    <section class="wrap section" id="packages"><div class="section-heading"><span class="kicker">Choose your format</span><h2>Two packages. One unmistakable chai identity.</h2><p>Compare the investment, included setup and opening materials, then enquire directly about the best fit for your location.</p></div><div class="package-grid">{packages.map((p:any,index:number)=><article class={`package-card reveal ${p.slug==='standard-franchise'?'standard':''}`}><div class="package-top"><span class="package-index">{index===0?'Classic':'Standard'}</span><FranchiseIcon type={index===0?'branding':'additional'} /></div><h3>{p.name}</h3><p class="price">{money(p.investment_amount)}</p><p class="package-description">{p.description}</p><ul class="highlight-list">{highlights(p).map((b:any)=><li><span>✓</span>{b.title}</li>)}</ul><div class="card-actions"><a class="button button-dark" href={`#details-${p.slug}`}>View Full Details</a><a class="button button-light" href={`https://wa.me/${digits}?text=${encodeURIComponent(`${defaultMessage} I am interested in the ${p.name}.`)}`} target="_blank" rel="noopener">Enquire Now</a></div></article>)}</div></section>

    <section class="comparison-section"><div class="wrap"><div class="section-heading light"><span class="kicker">The important differences</span><h2>Understand both packages in seconds.</h2></div><div class="comparison-grid">{[classic,standard].filter(Boolean).map((p:any)=><article class={`compare-card ${p.slug==='standard-franchise'?'standard':''}`}><div class="compare-head"><div><span>{p.slug==='standard-franchise'?'Expanded format':'Focused format'}</span><h3>{p.name}</h3></div><strong>{money(p.investment_amount)}</strong></div><div class="quick-facts"><p><span>Investment</span><strong>{money(p.investment_amount)}</strong></p><p><span>Fridge</span><strong>{spec(item(p,'Fridge'))}</strong></p><p><span>Chairs</span><strong class={included(p,'Chairs')?'yes':'no'}>{included(p,'Chairs')?qty(item(p,'Chairs')):'Not included'}</strong></p><p><span>32-inch LED TV</span><strong class={included(p,'32-inch LED TV')?'yes':'no'}>{included(p,'32-inch LED TV')?'1 unit':'Not included'}</strong></p><p><span>Additional gas stove</span><strong class={included(p,'Additional gas stove')?'yes':'no'}>{included(p,'Additional gas stove')?'1 unit':'Not included'}</strong></p><p><span>Tea powder</span><strong>{qty(item(p,'Tea powder'))}</strong></p></div><details><summary>Other key inclusions <span aria-hidden="true">⌄</span></summary><ul>{p.slug==='standard-franchise'?<><li>✓ Larger Standard raw-material quantities</li><li>✓ Existing stove plus one additional gas stove</li><li>✓ Branding, furniture and kitchen equipment</li></>:<><li>✓ Classic equipment and raw materials</li><li>✓ Existing Classic fridge specification retained</li><li>✓ Branding, furniture and kitchen equipment</li></>}<li>✓ Training and marketing support</li></ul></details></article>)}</div><p class="comparison-note">Package contents remain subject to written terms. Revenue and success are not guaranteed.</p></div></section>

    <section class="wrap section equipment-section"><div class="section-heading"><span class="kicker">Complete inclusions</span><h2>Every available item, clearly organised.</h2><p>Choose a package, then expand a category. Missing measurements are shown as “Not applicable”; unclear source text remains flagged for confirmation.</p></div><div class="package-switcher" role="tablist" aria-label="Select package details">{packages.map((p:any,i:number)=><button role="tab" type="button" aria-selected={i===0?'true':'false'} data-package-tab={p.slug}>{p.name}<span>{money(p.investment_amount)}</span></button>)}</div>{packages.map((p:any,i:number)=><article class="details-panel" id={`details-${p.slug}`} data-package-panel={p.slug} hidden={i!==0}><div class="details-title"><div><span class="kicker">Package contents</span><h3>{p.name}</h3></div><span>{p.franchise_package_items.length} included records</span></div><div class="accordion-grid">{groups(p).map((group:any)=><details class="category-card"><summary><FranchiseIcon type={iconType(group.name)} /><span class="summary-copy"><strong>{group.name}</strong><small>{group.items.length} items · Tap to expand</small></span><svg class="chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg></summary><div class="item-list">{group.items.map((i:any)=><article class="item-row"><div><strong>{i.name}</strong>{i.needs_confirmation&&<span class="confirmation">Needs Admin Confirmation</span>}</div><dl><div><dt>Quantity</dt><dd>{qty(i)}</dd></div><div><dt>Dimensions / capacity</dt><dd>{spec(i)}</dd></div>{i.unit_price!=null&&<div><dt>Unit price</dt><dd>{money(i.unit_price)}</dd></div>}</dl></article>)}</div></details>)}</div></article>)}</section>

    <section class="support-section"><div class="wrap"><div class="section-heading light"><span class="kicker">Support beyond setup</span><h2>Training, operations and launch support.</h2></div><div class="support-cards">{[['training','Three-day training','Recipe preparation, operations, customer service and business management.'],['marketing','Marketing support','Social page setup, branding, content planning and engagement guidance.'],['general','Franchise benefits','No royalty and applicable package benefits, subject to the written agreement.']].map(([type,title,summary])=><article class="support-card reveal"><FranchiseIcon type={type}/><h3>{title}</h3><p>{summary}</p><ul>{benefits.filter((b:any)=>b.benefit_type===type).slice(0,5).map((b:any)=><li>{b.title}</li>)}</ul></article>)}</div><div class="terms-strip"><strong>Transparent promotion policy</strong><p>Promotional revenue figures, “high returns,” business-support language and poster success wording are not guarantees of earnings, profit or outcomes.</p></div></div></section>

    <section class="wrap contact-section" id="apply"><div class="contact-copy"><span class="kicker">Start the conversation</span><h2>Ready to bring Chai Rides to your city?</h2><p>Call, message us on WhatsApp, or submit the application. The team will review your location and package preference.</p><div class="contact-actions"><a class="contact-action" href={`tel:+${digits}`}><span>Call Now</span><strong>{phone}</strong></a><a class="contact-action whatsapp" href={`https://wa.me/${digits}?text=${encodeURIComponent(defaultMessage)}`} target="_blank" rel="noopener"><span>WhatsApp Enquiry</span><strong>Start a conversation</strong></a></div></div><form class="enquiry-form" method="post" action="/api/franchise">{Astro.url.searchParams.has('sent')&&<p class="form-message success">Your enquiry was saved successfully. The team can now review it.</p>}{Astro.url.searchParams.has('error')&&<p class="form-message error">Please check the required fields.</p>}{Astro.url.searchParams.has('rate')&&<p class="form-message error">Please wait before sending another enquiry.</p>}<div class="field-grid"><label>Full name<input name="full_name" required minlength="2" maxlength="100" autocomplete="name" /></label><label>Mobile number<input name="mobile" required maxlength="20" autocomplete="tel" /></label><label>Email <span>Optional</span><input name="email" type="email" maxlength="160" autocomplete="email" /></label><label>City / location<input name="city" required maxlength="100" autocomplete="address-level2" /></label><label>Interested package<select name="package_id"><option value="">Select a package</option>{packages.map((p:any)=><option value={p.id}>{p.name} · {money(p.investment_amount)}</option>)}</select></label><label>Investment budget <span>Optional</span><input name="preferred_budget" maxlength="60" /></label></div><label class="honeypot">Website<input name="website" tabindex="-1" autocomplete="off" /></label><label>Message<textarea name="message" rows="4" maxlength="1500"></textarea></label><button class="button button-primary submit-button" type="submit">Submit Enquiry</button></form></section>

    <section class="wrap faq-section"><div><span class="kicker">Questions & terms</span><h2>Clear answers before you apply.</h2><p>{settings?.terms}</p></div><div>{faqs.map((f:any)=><details><summary>{f.question}<span>+</span></summary><p>{f.answer}</p></details>)}</div></section>
  </>}
</main><FranchiseLocations locations={locations} /><Footer footer={footer} />
<script>
const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;document.querySelectorAll<HTMLElement>('.reveal').forEach(el=>{if(reduced){el.classList.add('visible');return}new IntersectionObserver(([entry],observer)=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.disconnect()}},{threshold:.12}).observe(el)});
const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-package-tab]')];const panels=[...document.querySelectorAll<HTMLElement>('[data-package-panel]')];function selectPackage(slug:string){tabs.forEach(t=>t.setAttribute('aria-selected',String(t.dataset.packageTab===slug)));panels.forEach(p=>p.hidden=p.dataset.packagePanel!==slug)}tabs.forEach(t=>t.addEventListener('click',()=>selectPackage(t.dataset.packageTab!)));
document.querySelectorAll<HTMLAnchorElement>('a[href^="#details-"]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();const slug=a.hash.replace('#details-','');selectPackage(slug);document.querySelector('.equipment-section')?.scrollIntoView({behavior:reduced?'auto':'smooth'})}));
tabs.forEach((tab,index)=>tab.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;tabs[next].focus();selectPackage(tabs[next].dataset.packageTab!)}));
</script>
<style>
:global(html){scroll-behavior:smooth}.franchise-page{--forest:#103e2d;--forest-2:#18533c;--orange:#ea702d;--cream:#fff7e8;--ink:#173126;--line:#d9e1d8;background:var(--cream);color:var(--ink);overflow:hidden}.wrap{width:min(100%,1400px)}.kicker{display:block;color:var(--orange);font-size:.78rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.fr-hero{position:relative;min-height:calc(100svh - 70px);display:grid;align-items:center;padding:clamp(4rem,8vw,7rem) 0;background:linear-gradient(135deg,#0b3023,#164b37 62%,#1b5e43);color:white;isolation:isolate}.hero-layout{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(340px,.88fr);gap:clamp(2rem,7vw,7rem);align-items:center}.hero-copy{position:relative;z-index:2}.brand-lockup{display:flex;align-items:center;gap:1rem;margin-bottom:1.6rem}.brand-lockup img{width:68px;height:68px;object-fit:contain;background:white;border-radius:50%;padding:4px}.brand-lockup div{display:grid}.brand-lockup span{font-size:.75rem;letter-spacing:.13em;text-transform:uppercase;color:#d5e4d9}.brand-lockup strong{font-size:1.15rem;color:#ffb77f}.fr-hero h1{font-size:clamp(3.1rem,7vw,7rem);line-height:.92;letter-spacing:-.045em;max-width:920px}.fr-hero .hero-copy>p{font-size:clamp(1rem,1.5vw,1.2rem);max-width:650px;margin-top:1.5rem;color:#e7f0e9}.hero-actions,.card-actions,.contact-actions{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.button{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:.82rem 1.25rem;border-radius:999px;text-decoration:none;border:1px solid transparent;font-weight:800;cursor:pointer;transition:transform .25s,box-shadow .25s,background .25s}.button:hover{transform:translateY(-2px)}.button-primary{background:var(--orange);color:white;box-shadow:0 12px 28px #8a351d42}.button-ghost{border-color:#ffffff70;color:white;background:#ffffff0d}.button-dark{background:var(--forest);color:white}.button-light{border-color:var(--line);color:var(--forest);background:white}.hero-proof{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid #ffffff2b}.hero-proof span{display:grid;color:#cfe0d4;font-size:.82rem}.hero-proof strong{color:white;font-size:1.05rem}.chai-scene{position:relative;height:min(560px,62vh);min-height:430px;display:grid;place-items:center;filter:drop-shadow(0 35px 45px #061b1470)}.cup{position:absolute;width:min(330px,70vw);height:220px;border-radius:28px 28px 100px 100px;background:linear-gradient(145deg,#fff9ec,#e7d7bb);bottom:105px;z-index:3;box-shadow:inset -24px -18px 35px #bcae9547}.chai{position:absolute;inset:15px 17px auto;height:42px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#c9874d,#6d371c 75%);border:8px solid #f4e7d0}.cup-mark{position:absolute;inset:88px 0 auto;text-align:center;color:var(--forest);font:700 2.2rem/1 var(--f-display);letter-spacing:.05em}.handle{position:absolute;width:110px;height:120px;border:25px solid #eadcc4;border-left:0;border-radius:0 70px 70px 0;right:1%;bottom:145px;z-index:2}.saucer{position:absolute;width:min(420px,86vw);height:65px;border-radius:50%;background:linear-gradient(#f8edda,#cdbda5);bottom:73px;z-index:1}.steam{position:absolute;width:32px;height:140px;border-left:5px solid #ffffff80;border-radius:50%;top:30px;z-index:4;animation:steam 3.4s ease-in-out infinite}.steam-a{left:43%}.steam-b{left:52%;animation-delay:-1.3s;height:160px}.steam-c{left:59%;animation-delay:-2.1s;height:120px}.leaf{position:absolute;width:90px;height:44px;border-radius:100% 0 100% 0;background:#5f9567;z-index:0;animation:leaf 5s ease-in-out infinite}.leaf-a{left:3%;top:20%;transform:rotate(-22deg)}.leaf-b{right:2%;top:10%;transform:rotate(35deg);animation-delay:-2s}.scene-note{position:absolute;right:0;bottom:20px;z-index:5;padding:1rem 1.2rem;border:1px solid #ffffff38;border-radius:16px;background:#0a2b20c7;backdrop-filter:blur(12px);display:grid}.scene-note span{font-size:.72rem;color:#cfe0d4;text-transform:uppercase;letter-spac