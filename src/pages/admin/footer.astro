---
import SimpleBase from '../../layouts/SimpleBase.astro';
import Logo from '../../components/Logo.astro';
import RecordCards from '../../components/AdminRecordCards.astro';
import { fallbackAuthConfigured, isAdmin } from '../../lib/auth';
import { authConfigured, databaseConfigured, listAdminRecords } from '../../lib/supabase';
import '../../styles/admin-responsive.css';

const ready = databaseConfigured && (authConfigured || fallbackAuthConfigured);
const loggedIn = ready && await isAdmin(Astro.request);
let settings:any[] = [], links:any[] = [], policies:any[] = [], error = '';
if (loggedIn) try { [settings, links, policies] = await Promise.all(['site_settings','footer_links','legal_policies'].map(listAdminRecords)); } catch (e) { error = e instanceof Error ? e.message : 'Could not load footer data.'; }
---
<SimpleBase title="Footer management · Chai Rides" description="Manage public footer content" noindex>
  <main id="main" class="cms-shell">
    <header class="cms-top"><a href="/" class="cms-brand"><Logo/><span>CHAI RIDES</span></a><a class="cms-btn" href="/admin">Back to admin</a></header>
    {!ready ? <section class="login-card"><h1>Connect Supabase</h1><p>Footer management requires the configured admin backend.</p></section> : !loggedIn ? <section class="login-card"><h1>Admin login required</h1><p>Sign in at the admin dashboard first.</p><a class="cms-btn" href="/admin">Go to admin login</a></section> : <section class="cms-content">{error && <p class="alert error">{error}</p>}
      {settings.map((s:any)=><section class="cms-panel"><h1>Footer management</h1><form class="ajax-form cms-form grid" data-resource="settings" data-id={s.id}><label>Business phone<input name="phone" value={s.phone||'+91 6302567570'} required /></label><label>WhatsApp number<input name="whatsapp_number" value={s.whatsapp_number||s.phone||'+91 6302567570'} required /></label><label>Instagram URL<input name="instagram_url" type="url" value={s.instagram_url||''} /></label><label>Email<input name="footer_email" type="email" value={s.footer_email||''} /></label><label>Location<input name="footer_location" value={s.footer_location||s.location||''} /></label><label>Business hours<input name="business_hours" value={s.business_hours||''} /></label><label class="wide">Footer introduction<textarea name="footer_intro">{s.footer_intro||''}</textarea></label><label class="wide">Footer logo URL<input name="footer_logo_url" type="url" value={s.footer_logo_url||''} /></label><button class="cms-btn">Save footer settings</button></form></section>)}
      <section class="cms-panel"><h2>Quick links and social links</h2><form class="ajax-form cms-form grid" data-resource="footer_links"><label>Label<input name="label" required /></label><label>URL<input name="href" required /></label><label>Group<select name="link_group"><option value="quick">Quick link</option><option value="social">Social link</option></select></label><label>Sort order<input name="sort_order" type="number" value="0" /></label><label><input name="is_published" type="checkbox" checked /> Published</label><button class="cms-btn">Add link</button></form></section><RecordCards records={links} resource="footer_links" fields={['label','href','link_group','sort_order','is_published']} />
      <section class="cms-panel"><h2>Legal policies</h2><form class="ajax-form cms-form grid" data-resource="legal_policies"><label>Slug<input name="slug" required pattern="[a-z0-9-]+" /></label><label>Title<input name="title" required /></label><label class="wide">Content<textarea name="content" required></textarea></label><label>Sort order<input name="sort_order" type="number" value="0" /></label><label><input name="is_published" type="checkbox" checked /> Published</label><button class="cms-btn">Add policy</button></form></section><RecordCards records={policies} resource="legal_policies" fields={['slug','title','content','sort_order','is_published']} />
    </section>}
  </main>
  <script is:inline>const value=(el)=>el.type==='checkbox'?el.checked:el.type==='number'?(el.value===''?null:Number(el.value)):el.value||null;document.querySelectorAll('.ajax-form').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const body={};form.querySelectorAll('[name]').forEach(el=>body[el.name]=value(el));if(form.dataset.id)body.id=form.dataset.id;const r=await fetch(`/api/admin/${form.dataset.resource}`,{method:form.dataset.id?'PATCH':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});if(r.ok)location.reload();else alert((await r.json()).error||'Save failed')}));document.querySelectorAll('.delete-btn').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Delete this record?'))return;const r=await fetch(`/api/admin/${b.dataset.resource}`,{method:'DELETE',headers:{'content-type':'application/json'},body:JSON.stringify({id:b.dataset.id})});if(r.ok)location.reload();else alert('Delete failed')}));</script>
</SimpleBase>
