---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Beans from '../components/Beans.astro';
import Menu from '../components/Menu.astro';
import Bakery from '../components/Bakery.astro';
import BrandedCup from '../components/BrandedCup.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import WelcomeLoader from '../components/WelcomeLoader.astro';
import { loadSite } from '../lib/content';
import { loadFooterContent } from '../lib/supabase';

const [site, footer] = await Promise.all([loadSite(), loadFooterContent()]);
// Keep the file-backed homepage prerendered for Vercel. The Keystatic reader is
// build-time content; rendering it inside a serverless function can fail when
// the source content directory is not present in the function bundle.
export const prerender = true;
const { settings: s, page } = site;
const links = [
  { href: '#beans', label: 'Chai' },
  { href: '#menu', label: 'Menu' },
  ...(site.bakery.length ? [{ href: '#bakery', label: 'Snacks' }] : []),
  { href: '#visit', label: 'Visit' },
  { href: '/franchise', label: 'Franchise' },
];
---

<Base site={site} welcomeLoader>
  <WelcomeLoader />
  <Header name={s.name} themeKey={site.themeKey} showSwitcher={s.showThemeSwitcher} links={links} />

  <canvas id="stage" aria-hidden="true"></canvas>

  <main id="main">
    <Hero eyebrow={page.hero.eyebrow} title={page.hero.title} text={page.hero.text} stats={[...page.stats]} />
    <Ticker items={[...page.ticker]} />
    <Beans eyebrow={page.beans.eyebrow} title={page.beans.title} text={page.beans.text} origins={site.origins} steps={[...page.steps]} />
    <Menu
      eyebrow={page.menu.eyebrow}
      title={page.menu.title}
      note={page.menu.note}
      drinks={site.drinks}
      categories={site.categories}
      startDrink={site.startDrink}
      formatPrice={site.formatPrice}
    />
    <BrandedCup />
    <Bakery
      eyebrow={page.bakery.eyebrow}
      title={page.bakery.title}
      text={page.bakery.text}
      items={site.bakery}
      categories={site.bakeryCategories}
      formatPrice={site.formatPrice}
    />
    <Visit
      eyebrow={page.visit.eyebrow}
      title={page.visit.title}
      addressLines={site.addressLines}
      mapsUrl={site.mapsUrl}
      phone={s.phone}
      hours={site.hours}
      note={site.hoursNote}
      timeZone={s.timeZone}
    />
  </main>

  <Footer footer={footer} />

  <script>
    import '../scripts/site';
  </script>
</Base>
