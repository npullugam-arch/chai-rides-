---
import SimpleBase from '../layouts/SimpleBase.astro'; import Logo from '../components/Logo.astro'; import PageTitle from '../components/AdminPageTitle.astro'; import RecordCards from '../components/AdminRecordCards.astro'; import { fallbackAuthConfigured, isAdmin } from '../lib/auth'; import { authConfigured,supabaseConfigured as publicSupabaseConfigured,listAdminRecords } from '../lib/supabase'; import '../styles/admin-responsive.css';
// Admin CRUD uses the Supabase REST API with the protected service key; a
// direct PostgreSQL connection is not required on Vercel.
const backendReady=(authConfigured&&publicSupabaseConfigured)||fallbackAuthConfigured;const loggedIn=backendReady&&await isAdmin(Astro.request); let data:any={packages:[],items:[],benefits:[],enquiries:[],locations:[],images:[],faqs:[],settings:[],footer_links:[],legal_policies:[]},loadError='';
if(loggedIn){try{const keys=Object.keys(data);const tables=['franchise_packages','franchise_package_items','franchise_benefits','franchise_enquiries','franchise_locations','franchise_images','franchise_faqs','site_settings','footer_links','legal_policies'];const rows=await Promise.all(tables.map(listAdminRecords));keys.forEach((k,i)=>data[k]=rows[i])}catch(e){loadError=e instanceof Error?e.message:'Could not load admin data.'}}
const supabaseConfigured=backendReady;const tab=Astro.url.searchParams.get('tab')||'overview',uploadError=Astro.url.searchParams.get('upload_error'); const money=(n:number)=>new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:0}).format(n); const recent=data.enquiries.slice(0,5);
---
<SimpleBase title="Admin · Chai Rides" description="Chai Rides franchise administration" noindex><main id="main" class="cms-shell"><header class="cms-top"><a href="/" class="cms-brand"><Logo/><span>CHAI RIDES</span></a>{loggedIn&&<form method="post" action="/api/admin/logout"><button>Logout</button></form>}</header>
{!supabaseConfigured?<section class="login-card"><span class="eyebrow">Setup required</span><h1>Connect Supabase</h1><p>The dashboard is intentionally disabled until valid Supabase credentials are provided. Apply the migration and seed, create an admin user, then add the server environment variables.</p><a class="cms-btn" href="/franchise">View setup state</a></section>:!loggedIn?<section class="login-card"><span class="eyebrow">Secure administration</span><h1>Admin login</h1>{Astro.url.searchParams.has('error')&&<p class="alert error">Incorrect credentials or this user is not assigned the admin role.</p>}<form class="cms-form" method="post" action="/api/admin/login"><label>Email<input type="email" name="email" required autocomplete="username" /></label><label>Password<input type="password" name="password" required autocomplete="current-password" /></label><button class="cms-btn" type="submit">Login securely</button></form></section>:<div class="cms-layout"><nav class="cms-nav" aria-label="Admin sections">{[['overview','Overview'],['packages','Packages'],['items','Package items'],['benefits','Benefits & support'],['enquiries','Enquiries'],['locations','Locations'],['images','Images'],['settings','Website settings'],['faqs','FAQs']].map(([id,label])=><a class={tab===id?'active':''} href={`/admin?tab=${id}`}>{label}</a>)}</nav><section class="cms-content">{loadError&&<p class="alert error">{loadError}</p>}
{tab==='overview'&&<><div class="cms-heading"><span class="eyebrow">Dashboard overview</span><h1>Franchise management</h1></div><div class="metrics"><article><span>Total enquiries</span><strong>{data.enquiries.length}</strong></article><article><span>Total locations</span><strong>{data.locations.length}</strong></article><article><span>Active packages</span><strong>{data.packages.filter((p:any)=>p.is_active).length}</strong></article></div><section class="cms-panel"><h2>Recent enquiries</h2><div class="table-scroll"><table><thead><tr><th>Name</th><th>City</th><th>Mobile</th><th>Status</th><th>Received</th></tr></thead><tbody>{recent.map((e:any)=><tr><td>{e.full_name}</td><td>{e.city}</td><td>{e.mobile}</td><td>{e.status}</td><td>{new Date(e.created_at).toLocaleDateString('en-IN')}</td></tr>)}</tbody></table></div></section></>}
{tab==='packages'&&<><PageTitle kicker="Franchise catalog" title="Manage packages"/><section class="cms-panel"><h2>Add package</h2><form class="ajax-form cms-form grid" data-resource="packages"><label>Name<input name="name" required/></label><label>Slug<input name="slug" required/></label><label>Investment amount<input type="number" name="investment_amount" required/></label><label>Sort order<input type="number" name="sort_order" value="0"/></label><label class="wide">Description<textarea name="description"></textarea></label><label class="wide">Promotional offer<textarea name="promotional_offer"></textarea></label><label class="wide">Terms<textarea name="terms"></textarea></label><label><input type="checkbox" name="is_active" checked/> Active</label><button class="cms-btn">Add package</button></form></section><RecordCards records={data.packages} resource="packages" fields={['name','slug','investment_amount','description','promotional_offer','terms','sort_order','is_active']} /></>}
{tab==='items'&&<><PageTitle kicker="Package contents" title="Manage package items"/><section class="cms-panel"><form class="ajax-form cms-form grid" data-resource="items"><label>Package<select name="package_id" required>{data.packages.map((p:any)=><option value={p.id}>{p.name}</option>)}</select></label><label>Category<input name="category" required/></label><label>Item name<input name="name" required/></label><label>Quantity<input type="number" step="0.01" name="quantity"/></label><label>Unit<input name="unit" placeholder="kg, g, packet, piece"/></label><label>Dimensions<input name="dimensions"/></label><label>Optional unit price<input type="number" step="0.01" name="unit_price"/></label><label>Sort order<input type="number" name="sort_order" value="0"/></label><label><input type="checkbox" name="is_included" checked/> Included</label><label><input type="checkbox" name="needs_confirmation"/> Needs confirmation</label><label class="wide">Confirmation note<input name="confirmation_note"/></label><button class="cms-btn">Add item</button></form></section><RecordCards records={data.items} resource="items" fields={['category','name','quantity','unit','dimensions','unit_price','sort_order','is_included','needs_confirmation','confirmation_note']} /></>}
{tab==='benefits'&&<><PageTitle kicker="Support details" title="Manage benefits, training and marketing"/><section class="cms-panel"><form class="ajax-form cms-form grid" data-resource="benefits"><label>Package<select name="package_id"><option value="">All packages</option>{data.packages.map((p:any)=><option value={p.id}>{p.name}</option>)}</select></label><label>Type<select name="benefit_type"><option>general</option><option>training</option><option>marketing</option><option>promotion</option></select></label><label>Title<input name="title" required/></label><label>Sort order<input type="number" name="sort_order" value="0"/></label><label class="wide">Description<textarea name="description"></textarea></label><label><input type="checkbox" name="is_active" checked/> Active</label><button class="cms-btn">Add benefit</button></form></section><RecordCards records={data.benefits} resource="benefits" fields={['benefit_type','title','description','sort_order','is_active']} /></>}
{tab==='enquiries'&&<><PageTitle kicker="Leads" title="Manage enquiries"/><div class="filter-row"><input id="searchRecords" placeholder="Search name, city or mobile"/><select id="statusFilter"><option value="">All statuses</option><option>new</option><option>contacted</option><option>in_progress</option><option>converted</option><option>closed</option></select></div><div id="enquiryRecords"><RecordCards records={data.enquiries} resource="enquiries" searchable fields={['full_name','mobile','email','city','preferred_budget','message','status','internal_notes']} /></div></>}
{tab==='locations'&&<><PageTitle kicker="Network" title="Manage franchise locations"/><section class="cms-panel"><form class="ajax-form cms-form grid" data-resource="locations"><label>Franchise name<input name="franchise_name" required/></label><label>City<input name="city" required/></label><label>Contact name<input name="contact_name"/></label><label>Contact phone<input name="contact_phone"/></label><label>Status<select name="status"><option>planned</option><option>active</option><option>inactive</option></select></label><label>Image URL<input name="image_url"/></label><label class="wide">Address<textarea name="address" required></textarea></label><button class="cms-btn">Add location</button></form></section><RecordCards records={data.locations} resource="locations" fields={['franchise_name','city','address','contact_name','contact_phone','status','image_url']} /></>}
{tab==='images'&&<><PageTitle kicker="Media library" title="Manage franchise images"/>{uploadError&&<p class="alert error">{uploadError==='permission'?'Cloudinary denied image creation. In Cloudinary Settings → API Keys, assign this key the Media Library User or Master Admin role, then retry.':uploadError==='file'?'Use a JPG, PNG, WebP or GIF image up to 10 MB.':'Image upload failed. Check the Cloudinary configuration and try again.'}</p>}{Astro.url.searchParams.has('saved')&&<p class="alert success">Image uploaded successfully.</p>}<section class="cms-panel"><form class="cms-form grid" method="post" action="/api/admin/upload" enctype="multipart/form-data"><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required/></label><label>Assign to package<select name="package_id"><option value="">General franchise page</option>{data.packages.map((p:any)=><option value={p.id}>{p.name}</option>)}</select></label><label>Caption<input name="caption"/></label><label>Alt text<input name="alt_text" required/></label><button class="cms-btn">Upload image</button></form></section><div class="media-grid">{data.images.map((i:any)=><article class="cms-panel"><img src={i.public_url} alt={i.alt_text}/><form class="ajax-form cms-form" data-resource="images" data-id={i.id}><label>Caption<input name="caption" value={i.caption}/></label><label>Alt text<input name="alt_text" value={i.alt_text}/></label><label><input type="checkbox" name="is_published" checked={i.is_published}/> Published</label><button class="cms-btn">Save</button><button class="delete-btn" type="button" data-resource="images" data-id={i.id}>Delete</button></form></article>)}</div></>}
{tab==='settings'&&<><PageTitle kicker="Website" title="Edit franchise page settings"/>{data.settings.map((s:any)=><section class="cms-panel"><form class="ajax-form cms-form grid" data-resource="settings" data-id={s.id}>{['brand_name','tagline','location','phone','website_url','hero_heading','about_heading'].map(k=><label>{k.replaceAll('_',' ')}<input name={k} value={s[k]}/></label>)}{['whatsapp_message','hero_text','about_content','terms'].map(k=><label class="wide">{k.replaceAll('_',' ')}<textarea name={k}>{s[k]}</textarea></label>)}<button class="cms-btn">Save settings</button></form></section>)}</>}
{tab==='faqs'&&<><PageTitle kicker="Help content" title="Manage FAQs"/><section class="cms-panel"><form class="ajax-form cms-form grid" data-resource="faqs"><label class="wide">Question<input name="question" required/></label><label class="wide">Answer<textarea name="answer" required></textarea></label><label>Sort order<input type="number" name="sort_order" value="0"/></label><label><input type="checkbox" name="is_published" checked/> Published</label><button class="cms-btn">Add FAQ</button></form></section><RecordCards records={data.faqs} resource="faqs" fields={['question','answer','sort_order','is_published']} /></>}
</section></div>}</main>
<script is:inline>document.addEventListener('DOMContentLoaded',()=>{const input=document.querySelector('input[name="email"]');if(input){input.type='text';input.name='identity';input.previousSibling.textContent='Username or email';}});</script>
<script>const value=(el:HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement)=>el instanceof HTMLInputElement&&el.type==='checkbox'?el.checked:el instanceof HTMLInputElement&&['number','range'].includes(el.type)?(el.value===''?null:Number(el.value)):el.value||null;document.querySelectorAll<HTMLFormElement>('.ajax-form').forEach(form=>form.addEventListener('submit',async e=>{e.preventDefault();const body:any={};form.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('[name]').forEach(el=>body[el.name]=value(el));if(form.dataset.id)body.id=form.dataset.id;const r=await fetch(`/api/admin/${form.dataset.resource}`,{method:form.dataset.id?'PATCH':'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});if(r.ok)location.reload();else alert((await r.json()).error||'Save failed')}));document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Permanently delete this record?'))return;const r=await fetch(`/api/admin/${b.dataset.resource}`,{method:'DELETE',headers:{'content-type':'application/json'},body:JSON.stringify({id:b.dataset.id})});if(r.ok)location.reload();else alert('Delete failed')}));const search=document.querySelector<HTMLInputElement>('#searchRecords'),status=document.querySelector<HTMLSelectElement>('#statusFilter');const filter=()=>document.querySelectorAll<HTMLElement>('[data-search]').forEach(el=>el.hidden=!(el.dataset.search||'').includes((search?.value||'').toLowerCase())||!!status?.value&&!el.dataset.status?.includes(status.value));search?.addEventListener('input',filter);status?.addEventListener('change',filter);</script>
<style>:global(body){background:#f5f6f2}.cms-shell{min-height:100vh;color:#173126}.cms-top{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(1rem,4vw,3rem);background:#123c2d;color:white}.cms-brand{display:flex;align-items:center;gap:.7rem;text-decoration:none;font-weight:800}.cms-brand img{width:44px;height:44px;border-radius:50%}.cms-top button,.cms-btn{background:#e76f2e;color:white;border:0;border-radius:9px;padding:.75rem 1rem;font-weight:750;cursor:pointer;text-decoration:none}.cms-layout{display:grid;grid-template-columns:230px 1fr;max-width:1600px;margin:auto}.cms-nav{padding:2rem 1rem;border-right:1px solid #d9ddd7;display:grid;align-content:start;gap:.3rem}.cms-nav a{padding:.7rem 1rem;border-radius:8px;text-decoration:none}.cms-nav a.active,.cms-nav a:hover{background:#e1ece5;color:#123c2d}.cms-content{padding:clamp(1rem,4vw,3rem);min-width:0}.cms-heading h1,.login-card h1{font-size:clamp(2.2rem,5vw,4rem);margin:.5rem 0 2rem}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.metrics article,.cms-panel{background:white;border:1px solid #d9ddd7;border-radius:14px;padding:1.25rem;margin-bottom:1rem}.metrics strong{display:block;font-size:2.5rem}.cms-panel h2{margin-bottom:1rem}.cms-form{display:grid;gap:.8rem}.cms-form.grid{grid-template-columns:repeat(2,1fr)}.cms-form label{display:grid;gap:.3rem;text-transform:capitalize;font-weight:650}.cms-form .wide{grid-column:1/-1}.cms-form input,.cms-form textarea,.cms-form select,.filter-row input,.filter-row select{padding:.7rem;border:1px solid #bfc7bf;border-radius:7px;font:inherit;background:white;color:#173126}.cms-form textarea{min-height:85px}.record-grid,.media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:1rem}.media-grid img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:8px;margin-bottom:1rem}.delete-btn{background:transparent;border:1px solid #b33;color:#b33;border-radius:7px;padding:.6rem;cursor:pointer}.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:650px}th,td{text-align:left;padding:.7rem;border-bottom:1px solid #ddd}.filter-row{display:flex;gap:1rem;margin-bottom:1rem}.filter-row input{flex:1}.login-card{max-width:560px;margin:8vh auto;background:white;padding:clamp(1.5rem,5vw,3.5rem);border-radius:20px;border:1px solid #ddd}.alert{padding:1rem;border-radius:8px;background:#fee9e5;margin-bottom:1rem}@media(max-width:800px){.cms-layout{grid-template-columns:1fr}.cms-nav{display:flex;overflow:auto;border-right:0;border-bottom:1px solid #ddd;padding:1rem}.cms-nav a{white-space:nowrap}.metrics,.cms-form.grid{grid-template-columns:1fr}.cms-form .wide{grid-column:auto}}</style></SimpleBase>
