{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro(?:/(.*))$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/footer/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/upload/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/franchise/?$",
			"dest": "_render"
		},
		{
			"src": "^/franchise/?$",
			"dest": "_render"
		},
		{
			"src": "^/legal/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/robots\\.txt$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render"
		}
	]
}